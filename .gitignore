.venv/
__pycache__/
*.pyc

# Bulk downloaded/external raw data — regenerate via data_acquisition/ scripts,
# don't vendor into git. ocftc_digitized/ is deliberately NOT listed here: it
# holds hand-authored source data (ocftc_stops_manual.csv) worth tracking.
data/raw/osm/
data/raw/worldpop/
data/raw/admin_boundaries/
data/raw/lebanese_bus_routes/
data/raw/ocftc_digitized/geocode_cache.json

data/interim/
data/processed/

# outputs/ itself is tracked (maps/figures/tables are the actual submitted
# results — a grader shouldn't have to rerun the full pipeline, which needs
# live Nominatim + Python 3.14, just to see them). Only ignore large/derived
# subfolders that aren't part of outputs/{maps,figures,tables}.
outputs/**/*.log

.ipynb_checkpoints/
*.egg-info/
.env
cache/
.pytest_cache/
